fun empty () -> (int, fun (int) -> int) {
    (0, fun (i int) -> int { 0 })
}

fun cons (x int, xs (int, fun (int) -> int)) -> (int, fun (int) -> int) {
    (xs.0 + 1, fun (i int) -> int { if i == 0 { x } else { xs.1(i - 1) } })
}

fun car (xs (int, fun (int) -> int)) -> int {
    xs.1(0)
}

fun cdr (xs (int, fun (int) -> int)) -> (int, fun (int) -> int) {
    (xs.0 - 1, fun (i int) -> int { xs.1(i + 1) })
}

fun is_empty (xs (int, fun (int) -> int)) -> bool {
    xs.0 == 0
}

fun sum (xs (int, fun (int) -> int)) -> int {
    if is_empty(xs) { 0 } else { car(xs) + sum(cdr(xs)) }
}

fun main () -> int {
    let xs = cons(1, cons(2, cons(3, empty())));
    car(xs) * 100 + sum(cdr(xs)) * 10 + xs.0
}
