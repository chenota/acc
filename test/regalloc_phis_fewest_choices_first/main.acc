fun id (x int) -> int { x }

fun f (n int) -> int {
    let a = 0;
    let b = 0;
    let c = 0;
    let d = 0;
    let e = 0;
    let x = 0;
    if n > 0 {
        x = 1;
        id(x);
        a = n; b = n + 1; c = n + 2; d = n + 3; e = n + 4;
    } else {
        x = 2;
        id(x);
        a = n * 2; b = n * 2 + 1; c = n * 2 + 2; d = n * 2 + 3; e = n * 2 + 4;
    };
    let t = a + b + c + d + e;
    let s = id(x + t);
    a + b + c + d + e + s
}

fun main () -> int {
    if f(3) != 51 { return 1; };
    if f(-3) != -38 { return 2; };
    0
}
