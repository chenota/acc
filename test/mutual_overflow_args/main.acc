fun f (a int, b int, c int, d int, e int, g int, h int, n int) -> int {
    if n == 0 { a * 10 + h } else { g2(h, a, b, c, d, e, g, n - 1) }
}

fun g2 (a int, b int, c int, d int, e int, g int, h int, n int) -> int {
    if n == 0 { a * 10 + h } else { f(h, a, b, c, d, e, g, n - 1) }
}

fun main () -> int {
    f(1, 2, 3, 4, 5, 6, 7, 3)
}
