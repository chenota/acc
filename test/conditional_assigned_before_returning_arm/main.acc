fun f (c bool, n int) -> int {
    let x = n;
    if c {
        x = 7;
        return x + 1;
    } else {
        x = x * 2;
    };
    x
}

fun g (n int) -> int {
    let x = 0;
    if n == 0 {
        x = 1;
        return x * 50;
    } elif n > 0 {
        x = 2;
    } else {
        x = 3;
    };
    x
}

fun main () -> int {
    if f(true, 5) != 8 { return 1; };
    if f(false, 5) != 10 { return 2; };
    if g(0) != 50 { return 3; };
    if g(1) != 2 { return 4; };
    if g(-1) != 3 { return 5; };
    0
}
