fun main () -> int {
    let i = 0;
    let first = fun () -> int { 0 };
    loop {
        if i == 2 { break; };
        let k = 0;
        loop {
            if k == 2 { break; };
            let v = i * 10 + k + 1;
            let f = fun () -> int { v };
            if i == 0 { if k == 1 { first = f; }; };
            k = k + 1;
        };
        i = i + 1;
    };
    first()
}
