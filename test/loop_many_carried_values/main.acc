fun main () -> int {
    let a = 0;
    let b = 0;
    let c = 0;
    let d = 0;
    let e = 0;
    let f = 0;
    let g = 0;
    let h = 0;
    let j = 0;
    let k = 0;
    let l = 0;
    let m = 0;
    let n = 0;
    let o = 0;
    let p = 0;
    let i = 0;
    loop {
        if i == 2 { break; };
        a = a + 1;
        b = b + 2;
        c = c + 3;
        d = d + 4;
        e = e + 5;
        f = f + 6;
        g = g + 7;
        h = h + 8;
        j = j + 9;
        k = k + 10;
        l = l + 11;
        m = m + 12;
        n = n + 13;
        o = o + 14;
        p = p + 15;
        i = i + 1;
    };
    a + b + c + d + e + f + g + h + j + k + l + m + n + o + p
}
