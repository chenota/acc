fun main () -> int {
    let i = 0;
    let evens = 0;
    let odds = 0;
    loop {
        i = i + 1;
        if i > 9 { break; };
        if (i / 2) * 2 == i {
            evens = evens + i;
            continue;
        } else {
            odds = odds + 1;
        };
        odds = odds + 10;
    };
    evens * 2 + odds
}
