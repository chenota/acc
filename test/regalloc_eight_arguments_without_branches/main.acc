fun w8 (a int, b int, c int, d int, e int, f int, g int, h int) -> int {
    a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + g * 7 + h * 8
}

fun f (a int, b int, c int, d int, e int, g int, h int, i int) -> int {
    let z = 0;
    let q = a / 2;
    let r = w8(1, i, a, b - i - e * 3, c, 8, 1, z - e - 1);
    r - q + g * 2 + z - (1 - i)
}

fun main () -> int {
    if f(1, 17, 1, 4, 1, 5, 4, 12) != 101 { return 1; };
    if f(9, 3, 2, 0, 5, 6, 0, 7) != -3 { return 2; };
    0
}
