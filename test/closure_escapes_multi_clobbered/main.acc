fun clobber () -> int {
    let a = 111;
    let b = 222;
    let c = 333;
    let d = 444;
    let e = 555;
    let p = &a;
    let q = &b;
    return *p + *q + c + d + e;
}

fun make (a int, b int) -> fun () -> int {
    return fun () -> int { return a * 10 + b; };
}

fun main () -> int {
    let f = make(3, 4);
    clobber();
    return f();
}
