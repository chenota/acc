fun f (a bool, b bool) -> int {
    let x = 0;
    if a {
        x = 1;
        if b { x = x + 2; };
    } else {
        if b { x = 2; };
    };
    if b { x = x * 10; };
    if x > 10 { x = x - 5; };
    x
}

fun main () -> int {
    if f(true, true) != 25 { return 1; };
    if f(true, false) != 1 { return 2; };
    if f(false, true) != 15 { return 3; };
    if f(false, false) != 0 { return 4; };
    0
}
