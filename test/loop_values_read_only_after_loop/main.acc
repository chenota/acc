fun f (n int) -> int {
    let w = n + 20;
    let x = n + 21;
    let y = n + 22;
    let z = n + 23;
    let a = n + 1;
    let b = n + 2;
    let c = n + 3;
    let d = n + 4;
    let e = n + 5;
    let g = n + 6;
    let h = n + 7;
    let j = n + 8;
    let k = n + 9;
    let l = n + 10;
    let m = n + 11;
    let o = n + 12;
    let i = 0;
    let acc = 0;
    loop {
        if i == 10 { break; };
        acc = acc + a + b + c + d + e + g + h + j + k + l + m + o;
        i = i + 1;
    };
    acc + w + x + y + z
}

fun main () -> int {
    f(-6)
}
