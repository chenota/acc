fun g (p1 int, p2 int, p3 int, p4 int, p5 int, p6 int) -> int {
    return p1 + p2 + p3 + p4 + p5 + p6;
}

fun main () -> int {
    let v1 = 1;
    let v2 = 2;
    let v3 = 3;
    let v4 = 4;
    let v5 = 5;
    let v6 = 6;
    let r = g(v1, v2, v3, v4, v5, v6);
    return r + v1 + v2 + v3 + v4 + v5 + v6;
}
