fun id (x int) -> int { x }

fun split (n int) -> int {
    let a = n + 1;
    let b = n + 2;
    let d = n + 3;
    let e = n + 4;
    let k = id(n);
    let g = 8;
    let x = if k > 3 { a } else { b };
    let y = 1 - x;
    let z = id(d * e);
    a + g + y + z
}

fun shared (n int) -> int {
    let a = n + 1;
    let d = n + 2;
    let e = n + 3;
    let h = n + 4;
    let x = 0;
    if n > 0 { x = 1; id(x); } else { x = 2; id(x); };
    let y = 1 - x;
    let z = id(d * e * h);
    a + y + z
}

fun main () -> int {
    if split(5) != 81 { return 1; };
    if split(1) != 28 { return 2; };
    if shared(5) != 510 { return 3; };
    if shared(-1) != 5 { return 4; };
    0
}
