fun id (x int) -> int { x }

fun main () -> int {
    let a = 1;
    let b = 2;
    let c = 3;
    let d = 4;
    let e = 5;
    let f = 6;
    let g = 7;
    let i = 0;
    loop {
        if i == 3 { break; };
        a = a + id(1);
        b = b + 1;
        c = c + 1;
        d = d + 1;
        e = e + 1;
        f = f + 1;
        g = g + 1;
        i = i + 1;
    };
    a + b + c + d + e + f + g
}
